# Flutter engine + plugin rules are shipped by the Flutter Gradle plugin
# (flutter_proguard_rules.pro) and by each plugin AAR's own consumer rules.
# Only app-specific and cross-cutting rules belong here.

# App entry points reached by name (manifest / Flutter method channels).
-keep class com.kneayerng.hrms.MainActivity { *; }
-keep class com.kneayerng.hrms.security.** { *; }

# Generated by flutter; some loaders resolve it reflectively.
-keep class io.flutter.plugins.GeneratedPluginRegistrant { *; }

# Native methods must survive renaming so JNI lookups still resolve.
-keepclasseswithmembernames,includedescriptorclasses class * {
    native <methods>;
}

# Keep generic signatures and annotations used by serialization/reflection
# libraries at runtime (Dart-side JSON is unaffected, this covers Java/Kotlin).
-keepattributes Signature, InnerClasses, EnclosingMethod
-keepattributes *Annotation*
-keepattributes RuntimeVisibleAnnotations, RuntimeVisibleParameterAnnotations
-keepattributes AnnotationDefault

# Enums are looked up by name via Enum.valueOf.
-keepclassmembers,allowoptimization enum * {
    public static **[] values();
    public static ** valueOf(java.lang.String);
}

# Parcelable creators.
-keepclassmembers class * implements android.os.Parcelable {
    public static final ** CREATOR;
}

# Kotlin metadata is required by kotlinx-reflective APIs and coroutines.
-keep class kotlin.Metadata { *; }
-dontwarn kotlin.**
-keepclassmembers class **$WhenMappings {
    <fields>;
}

# Coroutines internals.
-dontwarn kotlinx.coroutines.**
-keepclassmembers class kotlinx.coroutines.** {
    volatile <fields>;
}

# Play services / ML Kit resolve optional modules at runtime; missing optional
# classes are warnings, not link failures.
-dontwarn com.google.android.gms.**
-dontwarn com.google.mlkit.**
-dontwarn com.google.firebase.**
-dontwarn org.conscrypt.**
-dontwarn org.bouncycastle.**
-dontwarn org.openjsse.**

# SQLite / WorkManager / AndroidX workers are constructed reflectively by the
# platform; their AARs ship consumer rules, these cover the remaining lookups.
-keep class * extends androidx.work.ListenableWorker { *; }
-dontwarn android.support.**
