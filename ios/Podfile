# Uncomment this line to define a global platform for your project
platform :ios, '15.5'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!
  use_modular_headers!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
end

pre_install do |_installer|
  grpc_core_include = File.expand_path('Pods/gRPC-Core/include', __dir__)
  next if File.exist?(File.join(grpc_core_include, 'grpc', 'module.modulemap'))

  cached_include = Dir[
    File.expand_path('~/Library/Caches/CocoaPods/Pods/Release/gRPC-Core/*/include')
  ].find { |path| File.exist?(File.join(path, 'grpc', 'module.modulemap')) }

  if cached_include
    require 'fileutils'
    FileUtils.mkdir_p(File.dirname(grpc_core_include))
    FileUtils.rm_rf(grpc_core_include)
    FileUtils.cp_r(cached_include, grpc_core_include)
  end
end

post_install do |installer|
  simulator_arch = `uname -m`.strip == 'x86_64' ? 'x86_64' : 'arm64'
  simulator_excluded_archs = simulator_arch == 'x86_64' ? 'arm64' : 'i386'

  installer.generated_projects.each do |project|
    project.targets.each do |target|
      target.build_configurations.each do |config|
        if config.base_configuration_reference
          xcconfig_path = config.base_configuration_reference.real_path
          if File.exist?(xcconfig_path)
            xcconfig = File.read(xcconfig_path)
            xcconfig_mod = xcconfig
              .gsub(/DT_TOOLCHAIN_DIR/, "TOOLCHAIN_DIR")
              .gsub(/EXCLUDED_ARCHS\[sdk=iphonesimulator\*\]\s*=\s*.*/, "EXCLUDED_ARCHS[sdk=iphonesimulator*] = #{simulator_excluded_archs}")
              .gsub(/ARCHS\[sdk=iphonesimulator\*\]\s*=\s*.*/, "ARCHS[sdk=iphonesimulator*] = #{simulator_arch}")
            File.open(xcconfig_path, "w") { |file| file << xcconfig_mod }
          end
        end

        config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.5'
        config.build_settings['ARCHS[sdk=iphonesimulator*]'] = simulator_arch
        config.build_settings['EXCLUDED_ARCHS[sdk=iphonesimulator*]'] = simulator_excluded_archs
      end
    end
  end

  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)

    target.build_configurations.each do |config|
      if config.base_configuration_reference
        xcconfig_path = config.base_configuration_reference.real_path
        if File.exist?(xcconfig_path)
          xcconfig = File.read(xcconfig_path)
          xcconfig_mod = xcconfig
            .gsub(/DT_TOOLCHAIN_DIR/, "TOOLCHAIN_DIR")
            .gsub(/EXCLUDED_ARCHS\[sdk=iphonesimulator\*\]\s*=\s*.*/, "EXCLUDED_ARCHS[sdk=iphonesimulator*] = #{simulator_excluded_archs}")
            .gsub(/ARCHS\[sdk=iphonesimulator\*\]\s*=\s*.*/, "ARCHS[sdk=iphonesimulator*] = #{simulator_arch}")
          File.open(xcconfig_path, "w") { |file| file << xcconfig_mod }
        end
      end

      config.build_settings['ARCHS[sdk=iphonesimulator*]'] = simulator_arch
      config.build_settings['EXCLUDED_ARCHS[sdk=iphonesimulator*]'] = simulator_excluded_archs
      config.build_settings['DEBUG_INFORMATION_FORMAT'] = 'dwarf-with-dsym' if ['Release', 'Profile'].include?(config.name)

      # Xcode 26 can incorrectly propagate the app bundle id into embedded pod
      # frameworks, which then breaks device installation with DuplicateIdentifier.
      if target.respond_to?(:product_type) &&
          target.product_type == 'com.apple.product-type.framework'
        safe_name = target.name.gsub(/[^A-Za-z0-9.-]/, '-')
        config.build_settings['PRODUCT_BUNDLE_IDENTIFIER'] = "org.cocoapods.#{safe_name}"
      end
    end
  end
end
